# Puertos de cada servicio
GATEWAY_PORT=4000
USERS_PORT=4001
REQUESTS_PORT=4002
RESERVATIONS_PORT=4003
RESOURCES_PORT=4004
EVENTS_PORT=4005
NOTIFICATIONS_PORT=4006

# Base de datos (compartida por todos los microservicios en esta etapa)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uajs_smart_campus

# Autenticación (usado por users-service)
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

# CORS: origen permitido para llamar al API Gateway
CORS_ORIGIN=http://localhost:5173
