# Puertos de cada servicio
GATEWAY_PORT=4000
USERS_PORT=4001
REQUESTS_PORT=4002
RESERVATIONS_PORT=4003
RESOURCES_PORT=4004
EVENTS_PORT=4005
NOTIFICATIONS_PORT=4006

# Base de datos (compartida por todos los microservicios en esta etapa)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uajs_smart_campus

# Autenticación (usado por users-service)
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

# CORS: origen permitido para llamar al API Gateway
CORS_ORIGIN=http://localhost:5173

# Zona horaria del negocio: define qué es "hoy" y "ahora" en las reglas de reservas y eventos
APP_TIMEZONE=America/Bogota

# Direcciones para que los servicios se consulten entre sí. Son opcionales: por defecto usan
# http://localhost:<puerto de cada servicio>. Solo se cambian en Docker, por ejemplo:
# USERS_SERVICE_URL=http://users-service:4001
# RESOURCES_SERVICE_URL=http://resources-service:4004
# NOTIFICATIONS_SERVICE_URL=http://notifications-service:4006
